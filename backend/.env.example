# Copy to .env and fill in the blanks:  cp .env.example .env

NODE_ENV=development
PORT=3000

# Matches the credentials in ../docker-compose.yml (local development only).
DATABASE_URL=postgres://commerce:commerce_local_dev_only@localhost:5432/commerce_engine

# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=commerce-engine
JWT_AUDIENCE=commerce-client
