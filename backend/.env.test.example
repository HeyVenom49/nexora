# Test environment. Copy to .env.test, then fill in JWT_SECRET:
#   cp .env.test.example .env.test
# Create the test database first (see the docker-compose setup in ../docker-compose.yml).

NODE_ENV=test
PORT=3001

# Points at the test database, never the dev database. Tests may delete rows.
DATABASE_URL=postgres://commerce:commerce_local_dev_only@localhost:5432/commerce_engine_test

# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=commerce-engine
JWT_AUDIENCE=commerce-client
